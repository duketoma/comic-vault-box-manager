{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "tsx watch server.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "import:collection": "node scripts/import-comic-csv.mjs",
    "import:series-totals": "node scripts/import-series-totals.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report",
    "android:build": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "desktop:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-app.ps1",
    "desktop:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-desktop-shortcut.ps1"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
